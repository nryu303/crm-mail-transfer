[Unit]
Description=CRM Carrier Messaging Platform
Documentation=https://49.212.164.254
After=network-online.target user@1000.service
Wants=network-online.target
# MySQL runs as a USER systemd unit (container-crm-mysql.service under
# /home/centos/.config/systemd/user). We can't directly depend on a user-unit
# from a system-unit, so ExecStartPre below polls the DB port instead.

[Service]
Type=simple
User=centos
Group=centos
WorkingDirectory=/home/centos/crm-platform

# Non-secret configuration (host names, IP allowlists, toolchain path)
Environment="JAVA_HOME=/usr/lib/jvm/java-1.8.0-openjdk"
Environment="SPRING_PROFILES_ACTIVE=dev"
Environment="OUTBOUND_ADAPTER=relay"
Environment="REPLY_BASE_URL=https://avu74g.jp"
Environment="SESSION_COOKIE_SECURE=true"
Environment="RELAY_URL=http://133.88.116.190:50000/api/mail/received"
Environment="RELAY_SSH_HOST=133.88.116.190"
Environment="RELAY_SSH_USER=root"
Environment="AMG_IPS=133.88.116.190,160.251.233.64,160.251.180.110,160.16.231.39,157.7.89.36,127.0.0.1"

# Secrets loaded from /etc/crm.env (mode 0600 root:root).
EnvironmentFile=-/etc/crm.env

# Wait up to 120 s for MySQL to accept connections before starting Spring.
# Without this, a fresh boot races the MySQL container and Spring throws a
# DB-connection error on startup. systemd's Restart=on-failure would
# eventually recover, but at the cost of a noisy boot.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do (echo > /dev/tcp/127.0.0.1/3306) >/dev/null 2>&1 && exit 0; sleep 2; done; echo "MySQL on 3306 not reachable after 120s"; exit 1'

ExecStart=/usr/lib/jvm/java-1.8.0-openjdk/bin/java -Xms256m -Xmx1g -jar /home/centos/crm-platform/target/crm.jar

SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
TimeoutStartSec=180

# Lockdown
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/centos/crm-platform

StandardOutput=journal
StandardError=journal
SyslogIdentifier=crm

[Install]
WantedBy=multi-user.target
